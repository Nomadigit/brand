{
  "name": "@nomadigit/brand",
  "version": "1.1.1",
  "description": "Nomadigit brand kit: tokens, logo, fonts, templates and agent guidelines in one place.",
  "license": "MIT",
  "author": "Nomadigit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nomadigit/brand.git"
  },
  "homepage": "https://nomadigit.github.io/brand/",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./tokens.json": "./tokens/brand.json",
    "./schema.json": "./schema/brand.schema.json",
    "./tokens/*": "./tokens/*",
    "./schema/*": "./schema/*",
    "./css": "./dist/tokens.css",
    "./fonts.css": "./assets/fonts/fonts.css",
    "./tailwind": "./dist/tailwind.preset.cjs",
    "./dist/*": "./dist/*",
    "./assets/*": "./assets/*",
    "./templates/*": "./templates/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist",
    "tokens",
    "schema",
    "assets",
    "templates",
    "guidelines",
    "AGENTS.md",
    "TRADEMARKS.md",
    "llms.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate-types": "node scripts/generate-types.js",
    "build:lib": "npm run generate-types && tsc -p tsconfig.json",
    "build:tokens": "tsx scripts/build.ts",
    "build:assets": "tsx scripts/render-assets.ts",
    "build": "npm run build:lib && npm run build:assets && npm run build:tokens",
    "test": "vitest run",
    "check": "npm run build && npm test && git diff --exit-code -- lib dist assets site",
    "og": "tsx scripts/og.ts",
    "site": "bash scripts/assemble-site.sh"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.19.43",
    "json-schema-to-typescript": "^15.0.4",
    "opentype.js": "^2.0.0",
    "png-to-ico": "^3.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
